worker_processes auto;
worker_rlimit_nofile 65536;
pid /tmp/nginx.pid;
error_log /dev/stderr notice;

events {
  worker_connections 4096;
  multi_accept on;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  resolver 127.0.0.11 valid=10s ipv6=off;

  log_format structured escape=json
    '{"time":"$time_iso8601","remote":"$remote_addr","host":"$host",'
    '"request":"$request","status":$status,"bytes":$body_bytes_sent,'
    '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';
  access_log /dev/stdout structured;

  sendfile on;
  tcp_nopush on;
  keepalive_timeout 65;
  keepalive_requests 1000;
  client_body_timeout 30s;
  client_header_timeout 15s;
  reset_timedout_connection on;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types application/javascript application/json application/xml image/svg+xml text/css text/plain;

  map $http_cf_connecting_ip $forwarded_client_ip {
    "" $remote_addr;
    default $http_cf_connecting_ip;
  }

  map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
  }

  map $http_x_forwarded_proto $forwarded_proto {
    "" $scheme;
    default $http_x_forwarded_proto;
  }

  upstream control_backend {
    server alvenqis-control:10788;
    keepalive 16;
  }

  upstream ops_backend {
    server alvenqis-ops:8080;
    keepalive 8;
  }

  upstream rpc_backend {
    server alvenqis-rpc:10787;
    keepalive 64;
  }

  upstream grafana_backend {
    server grafana:3000;
    keepalive 16;
  }

  upstream prometheus_backend {
    server prometheus:9090;
    keepalive 16;
  }

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $forwarded_client_ip;
  proxy_set_header X-Forwarded-For $forwarded_client_ip;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_connect_timeout 3s;
  proxy_send_timeout 90s;
  proxy_read_timeout 90s;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  server {
    listen 8080 default_server;
    server_name _;

    location = /gateway-health {
      access_log off;
      default_type application/json;
      return 200 '{"ok":true,"service":"alvenqis-gateway"}';
    }

    location / {
      return 404;
    }
  }

  server {
    listen 8080;
    server_name ${CONTROL_HOST};
    auth_basic "Alvenqis Control Plane";
    auth_basic_user_file /tmp/admin.htpasswd;

    location /setup/ {
      rewrite ^/setup/(.*)$ /$1 break;
      proxy_pass http://ops_backend;
    }

    location /ops/ {
      rewrite ^/ops/(.*)$ /$1 break;
      proxy_pass http://ops_backend;
    }

    location / {
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $forwarded_client_ip;
      proxy_set_header X-Forwarded-For $forwarded_client_ip;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_set_header X-Alvenqis-Admin-Authenticated "1";
      proxy_set_header X-Alvenqis-Admin-User $remote_user;
      proxy_pass http://control_backend;
    }
  }

  server {
    listen 8080;
    server_name ${FLEET_HOST};

    location = /fleet/status {
      proxy_pass http://control_backend/public/topology;
    }

    location /fleet/ {
      proxy_pass http://control_backend;
    }

    location / {
      default_type text/plain;
      return 200 "Alvenqis fleet endpoint\n";
    }
  }

  server {
    listen 8080;
    server_name ${RPC_HOST};
    client_max_body_size 1m;

    location = /pool {
      set $pool_backend http://alvenqis-pool:30787;
      proxy_pass $pool_backend/health;
    }

    location /pool/ {
      set $pool_backend http://alvenqis-pool:30787;
      rewrite ^/pool/(.*)$ /$1 break;
      proxy_pass $pool_backend;
    }

    location ^~ /mining/ {
      return 410;
    }

    location / {
      proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
      proxy_next_upstream_tries 2;
      proxy_pass http://rpc_backend;
    }
  }

  server {
    listen 8080;
    server_name ${GRAFANA_HOST};

    location / {
      proxy_pass http://grafana_backend;
    }
  }

  server {
    listen 8080;
    server_name ${PROMETHEUS_HOST};
    auth_basic "Alvenqis Prometheus";
    auth_basic_user_file /tmp/admin.htpasswd;

    location / {
      proxy_pass http://prometheus_backend;
    }
  }

  server {
    listen 8080;
    server_name ${POOL_HOST};

    location / {
      set $pool_backend http://alvenqis-pool:30787;
      proxy_pass $pool_backend;
    }
  }

  server {
    listen 8080;
    server_name ${WEBSITE_HOST} ${WWW_HOST};

    location / {
      set $website_backend http://alvenqis-website:8080;
      proxy_pass $website_backend;
    }
  }

  server {
    listen 8080;
    server_name ${EXPLORER_HOST};

    location / {
      set $explorer_backend http://alvenqis-explorer:8080;
      proxy_pass $explorer_backend;
    }
  }
}

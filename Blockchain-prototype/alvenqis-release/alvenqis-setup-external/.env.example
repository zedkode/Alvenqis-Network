COMPOSE_PROJECT_NAME=alvenqis-operator
ALVENQIS_OPERATOR_ROLE=node
# Legacy compatibility; new automation reads ALVENQIS_OPERATOR_ROLE first.
ALVENQIS_DEPLOYMENT_ROLE=node
STACK_VERSION=2.1.0-no-autoupdate
TZ=Europe/Bucharest
ALVENQIS_HOST_WORKSPACE=/opt/alvenqis/Blockchain-prototype/alvenqis-release/alvenqis-setup-external
ALVENQIS_HOST_REPO=/opt/alvenqis/Blockchain-prototype
ALVENQIS_HOST_ROOT=/opt/alvenqis
ALVENQIS_STATE_ROOT=/var/lib/alvenqis
ALVENQIS_STORAGE_KEY_FILE=/run/secrets/alvenqis_storage_key
ALVENQIS_REQUIRE_STORAGE_ENCRYPTION=true
ALVENQIS_ALLOW_PLAINTEXT_STORAGE_MIGRATION=false
VPS_MIN_FREE_DISK_BYTES=17179869184
ALVENQIS_VERSION=2.1.0-no-autoupdate
ALVENQIS_RUNTIME_IMAGE=ghcr.io/zedkode/alvenqis-runtime
ALVENQIS_OPS_IMAGE=ghcr.io/zedkode/alvenqis-ops
ALVENQIS_BACKUP_IMAGE=ghcr.io/zedkode/alvenqis-backup-scheduler
ALVENQIS_METRICS_IMAGE=ghcr.io/zedkode/alvenqis-metrics-exporter
ALVENQIS_GATEWAY_IMAGE=ghcr.io/zedkode/alvenqis-gateway
ALVENQIS_WEBSITE_IMAGE=ghcr.io/zedkode/alvenqis-website
ALVENQIS_EXPLORER_IMAGE=ghcr.io/zedkode/alvenqis-explorer
BASE_DOMAIN=example.invalid
PUBLIC_RPC_HOST=rpc.example.invalid
MINING_RPC_BIND=docker-internal
P2P_ADVERTISE_HOST=node.example.invalid
WEBSITE_HOST=www.example.invalid
WWW_HOST=www.example.invalid
EXPLORER_HOST=explorer.example.invalid
NODE_NAME=alvenqis-node-1
ADMIN_EMAIL=operator@example.invalid
ADMIN_OPERATOR_USER=alvenqis-operator
ADMIN_VIEWER_USER=alvenqis-viewer
CONTROL_ROLE=standalone
CONTROLLER_URL=
ENROLLMENT_TOKEN=
RELEASE_BUNDLE_URL=
CONTROL_HOST=control.example.invalid
# Compatibility aliases used by current templates; keep equal to the split values.
RPC_HOST=rpc.example.invalid
FLEET_HOST=fleet.example.invalid
FLEET_MTLS_HOST=fleet-mtls.example.invalid
# Keep loopback unless this controller intentionally accepts remote fleet mTLS.
FLEET_MTLS_BIND_ADDRESS=127.0.0.1
FLEET_MTLS_PORT=10443
# Pingora edge listeners stay inside the container except for the published
# fleet mTLS port above. Connection admission is bounded before HTTP/TLS work.
GATEWAY_HTTP_BIND=0.0.0.0:8080
GATEWAY_MTLS_BIND=0.0.0.0:10443
GATEWAY_METRICS_BIND=0.0.0.0:9091
GATEWAY_DNS_REFRESH_SECONDS=10
GATEWAY_RATE_LIMIT_MAX_KEYS=8192
GATEWAY_CONNECTION_RATE_PER_SECOND=200
GATEWAY_CONNECTION_BURST=400
GATEWAY_LOG_LEVEL=info
GRAFANA_HOST=grafana.example.invalid
PROMETHEUS_HOST=prometheus.example.invalid
POOL_HOST=pool.example.invalid
STRATUM_HOST=stratum.example.invalid
P2P_HOST=node.example.invalid
P2P_BIND_ADDRESS=0.0.0.0
HTTP_BIND_ADDRESS=0.0.0.0
STRATUM_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
P2P_PORT=20787
MAX_P2P_PEERS=64
STRATUM_PORT=3333
STRATUM_INTERNAL_PORT=3333
SEED_NODES_TOML=
P2P_MIN_VALIDATED_PEERS=0
OPS_BOOTSTRAP_PORT=8080
CLOUDFLARE_MODE=disabled
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_NAME=alvenqis-operator
PUBLIC_IPV4=
CLOUDFLARE_PROXY_HTTP=true
# Full reference pool (also starts its internal template gateway and TLS Stratum).
# The VPS image never contains alvenqis-miner and cannot hash on CPU.
ENABLE_POOL=false
POOL_NAME=Alvenqis Operator Pool
POOL_ADDRESS=
INDEXER_INTERVAL_SECONDS=5
INDEXER_FAILURE_BACKOFF_MAX_SECONDS=60
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=8GB
LOKI_RETENTION_HOURS=168
GRAFANA_ADMIN_USER=admin
BACKUP_INTERVAL_SECONDS=86400
BACKUP_INITIAL_DELAY_SECONDS=120
BACKUP_HEALTH_START_PERIOD=180s
BACKUP_RETENTION_DAYS=30
BACKUP_REMOTE_ENABLED=false
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_REGION=auto
CONTAINER_LOG_MAX_SIZE=20m
CONTAINER_LOG_MAX_FILES=3
NODE_MEMORY_LIMIT=2304M
NODE_CPU_LIMIT=2.25
RPC_MEMORY_LIMIT=1536M
RPC_CPU_LIMIT=1.25
CONTROL_MEMORY_LIMIT=384M
CONTROL_CPU_LIMIT=0.35
INDEXER_MEMORY_LIMIT=768M
INDEXER_CPU_LIMIT=0.75
POOL_MEMORY_LIMIT=768M
POOL_CPU_LIMIT=0.75
PROMETHEUS_MEMORY_LIMIT=768M
LOKI_MEMORY_LIMIT=768M
GRAFANA_MEMORY_LIMIT=512M
GATEWAY_MEMORY_LIMIT=192M
GATEWAY_CPU_LIMIT=0.20
WEBSITE_MEMORY_LIMIT=192M
WEBSITE_CPU_LIMIT=0.15
EXPLORER_MEMORY_LIMIT=192M
EXPLORER_CPU_LIMIT=0.15
CADVISOR_MEMORY_LIMIT=256M
CADVISOR_CPU_LIMIT=0.15

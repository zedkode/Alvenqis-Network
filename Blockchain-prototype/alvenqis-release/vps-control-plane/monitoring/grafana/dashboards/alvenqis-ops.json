        "type": "loki",
        "uid": "alvenqis-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "alvenqis-loki"
          },
          "expr": "{container=~\"alvenqis-.*\"} |~ \"(?i)error|fail|panic|fatal\"",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code"

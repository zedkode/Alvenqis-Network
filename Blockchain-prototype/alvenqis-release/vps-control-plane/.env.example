COMPOSE_PROJECT_NAME=alvenqis-control-plane
STACK_VERSION=2.1.0-no-autoupdate
TZ=Europe/Bucharest
ALVENQIS_HOST_WORKSPACE=/absolute/path/Alvenqis-Network/alvenqis-release/vps-control-plane
ALVENQIS_HOST_REPO=/absolute/path/Alvenqis-Network
ALVENQIS_HOST_ROOT=/absolute/path/Alvenqis_Network
ALVENQIS_STATE_ROOT=/var/lib/alvenqis-control-plane
ALVENQIS_STORAGE_KEY_FILE=/run/secrets/alvenqis_storage_key
ALVENQIS_REQUIRE_STORAGE_ENCRYPTION=true
ALVENQIS_ALLOW_PLAINTEXT_STORAGE_MIGRATION=false
ALVENQIS_VERSION=2.1.0-no-autoupdate
ALVENQIS_RUNTIME_IMAGE=ghcr.io/zedkode/alvenqis-runtime
ALVENQIS_OPS_IMAGE=ghcr.io/zedkode/alvenqis-ops
ALVENQIS_BACKUP_IMAGE=ghcr.io/zedkode/alvenqis-backup-scheduler
ALVENQIS_METRICS_IMAGE=ghcr.io/zedkode/alvenqis-metrics-exporter
ALVENQIS_GATEWAY_IMAGE=ghcr.io/zedkode/alvenqis-gateway
ALVENQIS_WEBSITE_IMAGE=ghcr.io/zedkode/alvenqis-website
ALVENQIS_EXPLORER_IMAGE=ghcr.io/zedkode/alvenqis-explorer
BASE_DOMAIN=dohotstudio.com
WEBSITE_HOST=dohotstudio.com
WWW_HOST=www.dohotstudio.com
EXPLORER_HOST=explorer.dohotstudio.com
NODE_NAME=bootstrap-eu-1
ADMIN_EMAIL=contact@dohotstudio.com
ADMIN_USER=alvenqis-admin
CONTROL_ROLE=controller
CONTROLLER_URL=
ENROLLMENT_TOKEN=
RELEASE_BUNDLE_URL=
CONTROL_HOST=control.dohotstudio.com
RPC_HOST=rpcnode.dohotstudio.com
FLEET_HOST=fleet.dohotstudio.com
GRAFANA_HOST=grafana.dohotstudio.com
PROMETHEUS_HOST=prometheus.dohotstudio.com
POOL_HOST=pool.dohotstudio.com
STRATUM_HOST=stratum.dohotstudio.com
P2P_HOST=node.dohotstudio.com
HTTP_PORT=80
P2P_PORT=20787
MAX_P2P_PEERS=64
STRATUM_PORT=3333
STRATUM_INTERNAL_PORT=3333
SEED_NODES_TOML=
P2P_MIN_VALIDATED_PEERS=0
OPS_BOOTSTRAP_PORT=8080
CLOUDFLARE_MODE=tunnel
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_NAME=alvenqis-control-plane
PUBLIC_IPV4=
CLOUDFLARE_PROXY_HTTP=true
# Full reference pool (also starts its internal template gateway and TLS Stratum).
# The VPS image never contains alvenqis-miner and cannot hash on CPU.
ENABLE_POOL=false
POOL_NAME=Alvenqis Reference Pool
POOL_ADDRESS=
INDEXER_INTERVAL_SECONDS=5
INDEXER_FAILURE_BACKOFF_MAX_SECONDS=60
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=8GB
LOKI_RETENTION_HOURS=168
GRAFANA_ADMIN_USER=admin
BACKUP_INTERVAL_SECONDS=86400
BACKUP_INITIAL_DELAY_SECONDS=120
BACKUP_HEALTH_START_PERIOD=180s
BACKUP_RETENTION_DAYS=30
BACKUP_REMOTE_ENABLED=false
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_REGION=auto
CONTAINER_LOG_MAX_SIZE=20m
CONTAINER_LOG_MAX_FILES=3
NODE_MEMORY_LIMIT=2304M
NODE_CPU_LIMIT=2.25
RPC_MEMORY_LIMIT=1536M
RPC_CPU_LIMIT=1.25
CONTROL_MEMORY_LIMIT=384M
CONTROL_CPU_LIMIT=0.35
INDEXER_MEMORY_LIMIT=768M
INDEXER_CPU_LIMIT=0.75
POOL_MEMORY_LIMIT=768M
POOL_CPU_LIMIT=0.75
PROMETHEUS_MEMORY_LIMIT=768M
LOKI_MEMORY_LIMIT=768M
GRAFANA_MEMORY_LIMIT=512M
GATEWAY_MEMORY_LIMIT=192M
GATEWAY_CPU_LIMIT=0.20
WEBSITE_MEMORY_LIMIT=192M
WEBSITE_CPU_LIMIT=0.15
EXPLORER_MEMORY_LIMIT=192M
EXPLORER_CPU_LIMIT=0.15
CADVISOR_MEMORY_LIMIT=256M
CADVISOR_CPU_LIMIT=0.15

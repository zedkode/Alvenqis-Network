COMPOSE_PROJECT_NAME=alvenqis-control-plane
STACK_VERSION=2.1.0-no-autoupdate
TZ=Europe/Bucharest
ALVENQIS_HOST_WORKSPACE=/absolute/path/Alvenqis-Network/alvenqis-release/vps-control-plane
ALVENQIS_HOST_REPO=/absolute/path/Alvenqis-Network
ALVENQIS_VERSION=2.1.0-no-autoupdate
ALVENQIS_RUNTIME_IMAGE=ghcr.io/zedkode/alvenqis-runtime
ALVENQIS_OPS_IMAGE=ghcr.io/zedkode/alvenqis-ops
ALVENQIS_BACKUP_IMAGE=ghcr.io/zedkode/alvenqis-backup-scheduler
ALVENQIS_METRICS_IMAGE=ghcr.io/zedkode/alvenqis-metrics-exporter
BASE_DOMAIN=dohotstudio.com
WEBSITE_HOST=dohotstudio.com
WWW_HOST=www.dohotstudio.com
WEBSITE_ORIGIN=http://alvenqis-website-runtime:18081
NODE_NAME=bootstrap-eu-1
ADMIN_EMAIL=contact@dohotstudio.com
ADMIN_USER=alvenqis-admin
CONTROL_ROLE=controller
CONTROLLER_URL=
ENROLLMENT_TOKEN=
RELEASE_BUNDLE_URL=
CONTROL_HOST=control.dohotstudio.com
RPC_HOST=rpcnode.dohotstudio.com
FLEET_HOST=fleet.dohotstudio.com
GRAFANA_HOST=grafana.dohotstudio.com
PROMETHEUS_HOST=prometheus.dohotstudio.com
POOL_HOST=pool.dohotstudio.com
STRATUM_HOST=stratum.dohotstudio.com
P2P_HOST=node.dohotstudio.com
HTTP_PORT=80
HTTPS_PORT=443
P2P_PORT=20787
STRATUM_PORT=3333
STRATUM_INTERNAL_PORT=3333
SEED_NODES_TOML=
OPS_BOOTSTRAP_PORT=8080
CLOUDFLARE_MODE=tunnel
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_NAME=alvenqis-control-plane
PUBLIC_IPV4=
CLOUDFLARE_PROXY_HTTP=true
# Full reference pool (also starts its internal template gateway and TLS Stratum).
# The VPS image never contains alvenqis-miner and cannot hash on CPU.
ENABLE_POOL=false
POOL_NAME=Alvenqis Reference Pool
POOL_ADDRESS=
INDEXER_INTERVAL_SECONDS=15
PROMETHEUS_RETENTION=30d
LOKI_RETENTION_HOURS=720
GRAFANA_ADMIN_USER=admin
BACKUP_INTERVAL_SECONDS=86400
BACKUP_INITIAL_DELAY_SECONDS=3600
BACKUP_RETENTION_DAYS=30
CHAIN_SNAPSHOT_STOP_SERVICES=true
BACKUP_REMOTE_ENABLED=false
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_REGION=auto
NODE_MEMORY_LIMIT=3G
RPC_MEMORY_LIMIT=3G
CONTROL_MEMORY_LIMIT=1G
INDEXER_MEMORY_LIMIT=1G
